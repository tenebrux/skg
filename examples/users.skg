# users.skg - block array of structured entries
#
# Use a block array when you need an ordered list of records with the
# same shape. Native typed loading maps it to a list of `User` values in Go,
# Rust, and Zig.
#
# Entries use `{ ... }` braces. Commas between object entries are accepted but
# optional; the canonical formatter emits one consistent form.
users [
  {
    name: "admin"
    sudo: true
    shell: "/usr/bin/zsh"
    groups: ["wheel", "video", "audio"]
  }
  {
    name: "builder"
    sudo: false
    shell: "/usr/bin/bash"
    groups: ["docker", "kvm"]
  }
  {
    name: "guest"
    sudo: false
    shell: "/usr/bin/nologin"
    groups: ["users"]
    # null explicitly overrides a value that an import might have set
    home: null
  }
]
