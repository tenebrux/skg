{
  "name": "vscode-skg",
  "displayName": "SKG Config",
  "description": "Syntax highlighting for .skg (Static Key Group) configuration files",
  "version": "0.1.0",
  "publisher": "tenebrux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tenebrux/skg.git"
  },
  "directory": "tools/vscode-skg",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "skg",
        "aliases": [
          "SKG Config",
          "skg"
        ],
        "extensions": [
          ".skg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skg",
        "scopeName": "source.skg",
        "path": "./syntaxes/skg.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.1"
  },
  "scripts": {
    "test": "node check-grammar.mjs"
  }
}
