amends "package://github.com/jdx/hk/releases/download/v1.41.0/hk@1.41.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.41.0/hk@1.41.0#/Builtins.pkl" as builtins

local linters = new Mapping<String, Step> {
  ["zig-fmt"] {
    glob = List("*.zig")
    check = "zig fmt --check {{files}}"
    fix = "zig fmt {{files}}"
  }
  ["go-fmt"] = builtins.go_fmt
  ["go-vet"] = builtins.go_vet
}

// Keep in step with `mise run ci` and .github/workflows/ci.yml. Three gates
// that check different things is how a push goes green locally and red on CI.
//
// -race matches the CI invocation: the conformance runner walks the fixture
// tree from several subtests, and a data race there would otherwise only ever
// show up in CI.
local tests = new Mapping<String, Step> {
  ["zig-test"] {
    check = "zig build test"
    exclusive = true
  }
  ["go-test"] {
    check = "cd go && go test -race ./..."
    exclusive = true
  }
  ["tree-sitter"] {
    glob = List("tools/tree-sitter-skg/**", "testdata/**")
    check = "mise run test:tree-sitter"
    exclusive = true
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["pre-push"] {
    steps = tests
  }
}
